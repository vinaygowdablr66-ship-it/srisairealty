# Server
PORT=3000
# Change this to a secure random secret in production
JWT_SECRET=change-this-secret-key
# Default admin login (seed via: node sql/seed-admin.js <username> <password>)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Supabase
SUPABASE_URL=your-supabase-url
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Storage bucket name (create in Supabase Dashboard > Storage > New bucket)
SUPABASE_BUCKET=property-images
